{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mintu",
  "version": "0.2.0",
  "identifier": "com.mintu.desktop",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mintu",
        "url": "index.html",
        "width": 1920,
        "height": 1080,
        "resizable": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "shadow": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Cute animated mint-green living desktop companion",
    "longDescription": "Mintu is an animated desktop companion living in a Dynamic Island with Free mode, local AI chat, SMTC media control, notifications, and context awareness.",
    "copyright": "Copyright 2026 Mintu Contributors (MIT)",
    "resources": [
      "binaries/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
